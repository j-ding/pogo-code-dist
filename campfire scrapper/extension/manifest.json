{
  "manifest_version": 3,
  "name": "Campfire Meetup Tracker",
  "version": "1.0.0",
  "description": "Collect Campfire meetups in one panel, pick the ones you want, and export check-in / RSVP data.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://campfire.scopely.com/*"],
  "action": {
    "default_title": "Toggle Campfire Meetup Tracker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://campfire.scopely.com/*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://campfire.scopely.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
